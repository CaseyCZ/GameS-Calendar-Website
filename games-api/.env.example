# PlayStation persisted-query hashes can change. Override without editing code when Sony rotates them.
PS_HASH_MET_GET_PRODUCT_BY_ID=
PS_HASH_MET_GET_CONCEPT_BY_ID=
PS_HASH_FEATURES_RETRIEVE=
PS_HASH_CATEGORY_GRID_RETRIEVE=
PS_HASH_PRICING_BY_CONCEPT=
PS_HASH_MEDIA_BY_CONCEPT=

GAMES_API_RATE_LIMIT_PER_MINUTE=180
